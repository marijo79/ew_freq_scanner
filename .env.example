# Copy this file to .env and adjust values, then run: python -m freqscan

# ---- Select active SDR backend: "rtl" or "hackrf" ----
SDR=hackrf

# ---- Shared ----
WATERFALL_ROWS=100

# ---- RTL-SDR settings (used when SDR=rtl) ----
RTL__BIN_SIZE=10k
RTL__GAIN=50
RTL__INTERVAL=1
RTL__EDGE_TRIM=0.15
RTL__DEVICES=[{"id":0,"freq_start":"80M","freq_stop":"120M","label":"Device 0  80-120 MHz"},{"id":1,"freq_start":"420M","freq_stop":"470M","label":"Device 1 420-470 MHz"},{"id":2,"freq_start":"850M","freq_stop":"900M","label":"Device 2 850-900 MHz"}]

# ---- HackRF settings (used when SDR=hackrf) ----
HACKRF__LNA_GAIN=32
HACKRF__VGA_GAIN=20
HACKRF__RANGES=[{"freq_start":850,"freq_stop":950,"label":"850-950 MHz","bin_width":20000,"edge_trim":0.02},{"freq_start":2300,"freq_stop":2500,"label":"2300-2500 MHz","bin_width":100000,"edge_trim":0.05},{"freq_start":5700,"freq_stop":5900,"label":"5700-5900 MHz","bin_width":100100,"edge_trim":0.05}]
